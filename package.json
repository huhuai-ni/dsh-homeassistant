{
  "name": "dsh-homeassistant",
  "version": "0.2.1",
  "description": "DSH 插件：用 Home Assistant 接管米家（小米智能家居）设备 —— 灯、空调、风扇、红外遥控，带设置页与完整教程",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "home-assistant",
    "xiaomi",
    "mijia",
    "miio",
    "miot",
    "smart-home",
    "xiaomi-miot"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "huhuai-ni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huhuai-ni/dsh-homeassistant.git"
  },
  "homepage": "https://github.com/huhuai-ni/dsh-homeassistant#readme",
  "bugs": {
    "url": "https://github.com/huhuai-ni/dsh-homeassistant/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  }
}